{
  "framework": "vite",
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://outbox-assessment-g02v.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://outbox-assessment-g02v.onrender.com/uploads/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://outbox-assessment-g02v.onrender.com/admin/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ]
}
