# ===============================================
# Outbox Email Scheduler - Environment Variables
# ===============================================
# Copy this file to .env and fill in the values

# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
# Local MongoDB (default)
MONGODB_URI=mongodb://127.0.0.1:27017/outbox_scheduler
# Atlas (uncomment when you have the connection string)
# MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/outbox_scheduler?retryWrites=true&w=majority

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379

# ---- JWT ----
JWT_SECRET=outbox-secret-key-super-secure-production-jwt-token-2026

# ---- Google OAuth (optional — demo mode works without this) ----
GOOGLE_CLIENT_ID=

# ---- Rate Limiting Defaults ----
MAX_EMAILS_PER_HOUR=10
DEFAULT_DELAY_BETWEEN_EMAILS_MS=2000
WORKER_CONCURRENCY=5

# ---- Slack Webhook (optional) ----
SLACK_WEBHOOK_URL=

# ---- Cloudinary (optional — local upload fallback is automatic) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Resend Email API (Recommended for Cloud / Render deployments) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ---- Custom SMTP / Nodemailer (Fallback if Resend is not configured) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

